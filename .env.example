# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual keys.

# Required for a local (no-container) run: the API key for your
# OpenAI-compatible LLM endpoint. Under Docker Compose it is read from
# .secrets/agent_access_token.txt instead.
AGENT_ACCESS_TOKEN=

# Optional: overrides llm.base_url from config.yaml. Any OpenAI-compatible
# endpoint that serves /chat/completions (and /embeddings, for semantic
# memory) works, e.g. https://api.openai.com/v1 or a local vLLM/Ollama server.
LLM_BASE_URL=

# Optional: only needed if you want the brave-search MCP server to start.
# Get a key at https://api-dashboard.search.brave.com/. If unset, that one
# server is skipped at boot — the rest of the harness still works. The key is
# read by Docker Compose and is never stored in the repository.
BRAVE_API_KEY=

# Optional: overrides session.url from config.yaml. Only needed for a local
# (no-container) run — config.yaml's default (redis://redis:6379/0) is a
# Docker Compose service name that doesn't resolve outside that network.
# If Redis isn't reachable, short-term memory just won't persist; the
# harness still runs.
REDIS_URL=redis://localhost:6379/0
